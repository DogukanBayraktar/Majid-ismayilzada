# Port
PORT=3000

# Oturum gizli anahtarı (uzun ve rastgele bir cümle yazın)
SESSION_SECRET=degistir-beni-cok-uzun-rastgele-bir-cumle-yazin

# İlk admin giriş bilgileri (panelde "Güvenlik" sekmesinden değiştirilebilir)
ADMIN_USER=admin
ADMIN_PASS=admin123

# GitHub yedekleme (her kayıt otomatik bu repoya commit yapılır)
# https://github.com/settings/tokens/fine-grained adresinden üretilir
# Repository access: Sadece bu repo -> Contents: Read and write, Metadata: Read
GITHUB_TOKEN=
GITHUB_OWNER=DogukanBayraktar
GITHUB_REPO=Majid-ismayilzada
GITHUB_BRANCH=main