<%- include('./_head') -%>
<body class="has-savebar">
<%- include('./_sidebar', { active: active, backupActive: backupActive }) -%>

<main class="content">
  <h1>Genel Ayarlar</h1>
  <div class="page-sub">Logo, çalışma saatleri ve SEO başlık/açıklama. Bu ayarlar sitede tüm sayfalara otomatik uygulanır; mesaj ve CTA metinleri için <strong>Site Ayarları</strong>, iletişim bilgileri için <strong>İletişim</strong> sayfasını kullanın.</div>

  <% if (loadError) { %>
    <div class="alert err"><strong>Veri dosyası okunamadı.</strong> data/site.js içinde sözdizimi hatası olabilir.</div>
  <% } else { %>
    <% if (saved) { %><div class="alert ok">Kaydedildi.</div><% } %>
    <% if (backup === 'ok') { %><div class="alert ok">Değişiklikler GitHub'a da yedeklendi.</div><% } %>
    <% if (backup === 'skip') { %><div class="alert warn">GitHub yedeği ayarlanmadı — değişiklikler yalnızca bu sunucuda duruyor.</div><% } %>
    <% if (backup === 'fail') { %><div class="alert err">Kayıt yapıldı ama GitHub yedeği başarısız oldu.</div><% } %>

    <form method="post" action="/admin/site/save" id="siteForm">
      <div class="card">
        <h2>Logo</h2>
        <div class="page-sub">Üst menü ve footer'daki logo. Görsel seçmek için "Yükle" butonunu kullanın.</div>
        <div class="field">
          <label for="logo">Logo görseli</label>
          <div class="imgpick">
            <input type="text" id="logo" name="logo" class="inp" value="<%= settings.logo || '' %>" placeholder="assets/images/logo.png">
            <button type="button" class="btn btn-sm btn-outline" title="Görsel yükle" onclick="pickImage('logo')">↗ Yükle</button>
          </div>
        </div>
      </div>

      <div class="card">
        <h2>Çalışma Saatleri</h2>
        <div class="page-sub">İletişim sayfasında "Çalışma Saatleri" kartında görüntülenen metin.</div>
        <div class="field">
          <label for="workingHours">Metin</label>
          <input type="text" id="workingHours" name="workingHours" class="inp" value="<%= settings.workingHours || '' %>" placeholder="Pzt–Cmt: 10:00 – 19:00 · Pazar Kapalı">
        </div>
      </div>

      <div class="card">
        <h2>SEO</h2>
        <div class="page-sub">Tarayıcı sekmesinde ve Google sonuçlarında görünen başlık ile açıklama (meta description).</div>
        <div class="field">
          <label for="seoTitle">Sayfa başlığı (title)</label>
          <input type="text" id="seoTitle" name="seoTitle" class="inp" value="<%= settings.seoTitle || '' %>">
        </div>
        <div class="field">
          <label for="seoDescription">Açıklama (meta description)</label>
          <textarea id="seoDescription" name="seoDescription" class="inp" rows="3"><%= settings.seoDescription || '' %></textarea>
        </div>
      </div>

      <div class="savebar">
        <div class="sb-title">
          Genel Ayarlar
          <small>Değişiklikler "Kaydet" ile kaydedilir</small>
        </div>
        <div class="sb-actions">
          <a href="/admin/services" class="btn btn-outline">Vazgeç</a>
          <button type="submit" class="btn">Kaydet</button>
        </div>
      </div>
    </form>
  <% } %>
</main>

<%- include('./_foot') -%>